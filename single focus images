% =========================================================================
% extractSharpestFrames.m
% --------------------------------------------------------------
% Ziel   : Für jedes MP4-Video in einem Ordner den Frame mit höchster
%          Schärfe (Kombination aus Grauwert-Amplitude + Varianz) finden.
%
%          Anschließend wird NICHT der schärfste Frame selbst gespeichert,
%          sondern der 8. folgende Frame.
%
%          Beispiel:
%          Schärfster Frame = 125
%          Gespeicherter Frame = 133
%
%          Zusätzlich wird ein Überblick in einer Excel-Tabelle erzeugt.
%          Außerdem wird ein Log-File angelegt.
%
% Hinweis :
%   - Das Skript nutzt hasFrame / readFrame.
%   - Optional kann Parallelisierung aktiviert werden.
%   - Die Schärfe-Metrik ist:
%       score = wAmp*Amplitude + wVar*Varianz
%   - Gespeichert wird das Original-RGB-Bild.
% =========================================================================

clear;  clc;  close all;

%% 1. Ordner mit Videos auswählen -------------------------------------------------
folder = uigetdir(pwd, 'Bitte Ordner mit Videos auswählen');
if isequal(folder,0) || isempty(folder)
    error('Kein Ordner ausgewählt – Abbruch.');
end

%% 2. MP4-Dateien im Ordner finden -------------------------------------------------
videoFiles = dir(fullfile(folder, '*.mp4'));
if isempty(videoFiles)
    error('Keine MP4-Videos im ausgewählten Ordner gefunden.');
end

%% 3. Ausgabe-Ordner für die besten Frames anlegen --------------------------------
outFolder = fullfile(folder, 'SchärfsteFrames');
if ~exist(outFolder,'dir')
    mkdir(outFolder);
end

%% 4. Gewichtung für die kombinierte Schärfe-Metrik -------------------------------
weightAmplitude = 0.6;   % Anteil Amplitude (0…1)
weightVariance  = 0.4;   % Anteil Varianz    (0…1)

%% 5. Anzahl Frames nach dem schärfsten Frame -------------------------------------
framesAfterSharpest = 8;

%% 6. Ergebnis-Struktur ------------------------------------------------------------
results = struct('VideoName', {}, ...
                 'BestFrameIdx', {}, ...
                 'SavedFrameIdx', {}, ...
                 'BestScore', {}, ...
                 'BestFrameFile', {});   %#ok<*NASGU>

%% 7. Log-Datei anlegen ------------------------------------------------------------
logFile = fullfile(folder, 'SchärfsteFrames_Log.txt');
logID   = fopen(logFile,'w');

if logID == -1
    error('Log-Datei konnte nicht geöffnet werden.');
end

fprintf(logID,'--- Schärfste-Frames Log (%s) ---\n', datestr(now));

%% 8. Parallelisierung (optional) -------------------------------------------------
useParallel = false;                     % <- bei Bedarf auf true setzen

if useParallel
    % Öffnet einen lokalen Parallel-Pool, falls keiner läuft
    if isempty(gcp('nocreate'))
        parpool('local');
    end
end

%% 9. Verarbeitung sämtlicher Videos ----------------------------------------------
if useParallel

    % --------------------------- PARALLEL ---------------------------
    parfor i = 1:numel(videoFiles)

        results(i) = processSingleVideo( ...
            fullfile(folder, videoFiles(i).name), ...
            outFolder, ...
            weightAmplitude, ...
            weightVariance, ...
            framesAfterSharpest, ...
            []);   % logID nicht innerhalb parfor verwenden

    end

else

    % -------------------------- SERIELL ---------------------------
    for i = 1:numel(videoFiles)

        results(i) = processSingleVideo( ...
            fullfile(folder, videoFiles(i).name), ...
            outFolder, ...
            weightAmplitude, ...
            weightVariance, ...
            framesAfterSharpest, ...
            logID);

    end

end

%% 10. Log-Datei schließen ---------------------------------------------------------
fclose(logID);

%% 11. Excel-Tabelle erzeugen ------------------------------------------------------
excelFile = fullfile(folder, 'SchärfsteFrames_Übersicht.xlsx');

tbl = struct2table(results);

writetable(tbl, excelFile, 'WriteVariableNames', true);

%% 12. Abschlussausgabe ------------------------------------------------------------
fprintf('\n✅ Verarbeitung abgeschlossen.\n');
fprintf('✅ Gespeicherte Frames: %s\n', outFolder);
fprintf('✅ Ergebnis-Tabelle (Excel):      %s\n', excelFile);
fprintf('✅ Log-Datei:                     %s\n', logFile);


% =========================================================================
% ==================== FUNKTIONSBLOCK: Einzelnes Video =====================
% =========================================================================
function result = processSingleVideo(videoPath, outFolder, ...
                                     wAmp, wVar, ...
                                     framesAfterSharpest, logID)

% ---------------------------------------------------------------
% Eingaben
%   videoPath             : voller Pfad zur MP4-Datei
%   outFolder             : Zielordner für das Bild
%   wAmp,wVar             : Gewichtungen für Amplitude und Varianz
%   framesAfterSharpest   : Anzahl Frames nach dem schärfsten Frame
%   logID                 : File-Identifier zum Schreiben ins Log
%
% Ausgabe
%   result                : Struktur mit Feldern
%                           VideoName
%                           BestFrameIdx
%                           SavedFrameIdx
%                           BestScore
%                           BestFrameFile
% ---------------------------------------------------------------

    [~, name, ext] = fileparts(videoPath);
    videoName      = [name, ext];

    % --------- Log-Eintrag (Start) ----------
    if ~isempty(logID)
        fprintf(logID,'\nVideo: %s\n', videoName);
    end

    fprintf('Verarbeite Video: %s\n', videoName);

    % --------- Video öffnen ----------
    try
        vR = VideoReader(videoPath);

    catch ME

        warning('Kann Video nicht öffnen: %s – %s', ...
                videoPath, ME.message);

        if ~isempty(logID)
            fprintf(logID, ...
                '  >> KANN NICHT GEÖFFNET WERDEN: %s\n', ...
                ME.message);
        end

        result = struct( ...
            'VideoName', videoName, ...
            'BestFrameIdx', NaN, ...
            'SavedFrameIdx', NaN, ...
            'BestScore', NaN, ...
            'BestFrameFile', '');

        return;
    end

    % --------- Initialisierung ----------
    bestScore    = -inf;
    bestIdx      = NaN;
    frameCnt     = 0;

    % --------- Frame-Schleife zur Ermittlung des schärfsten Frames ----------
    while hasFrame(vR)

        try

            % 1. Frame einlesen
            frameRGB = readFrame(vR);

            frameGray = rgb2gray(frameRGB);
            frameGray = im2double(frameGray);

            % 2. Schärfe-Parameter
            amplitude = max(frameGray(:)) - min(frameGray(:));
            variance  = var(frameGray(:));

            % 3. Kombinierte Schärfe-Metrik
            score = wAmp * amplitude + wVar * variance;

            % 4. Bester Frame ermitteln
            if score > bestScore

                bestScore = score;
                bestIdx   = frameCnt + 1;

            end

            frameCnt = frameCnt + 1;

        catch ME

            warning('Fehler bei Frame %d in %s – %s', ...
                    frameCnt + 1, videoPath, ME.message);

            if ~isempty(logID)
                fprintf(logID, ...
                    '  >> Frame %d: %s\n', ...
                    frameCnt + 1, ME.message);
            end

            frameCnt = frameCnt + 1;

        end
    end

    % --------- Kein Frame gefunden? ----------
    if isnan(bestIdx)

        warning('Kein lesbarer Frame gefunden in %s', videoPath);

        if ~isempty(logID)
            fprintf(logID, ...
                '  >> KEIN LESBARER FRAME GEFUNDEN.\n');
        end

        result = struct( ...
            'VideoName', videoName, ...
            'BestFrameIdx', NaN, ...
            'SavedFrameIdx', NaN, ...
            'BestScore', NaN, ...
            'BestFrameFile', '');

        return;
    end

    % =========================================================================
    % AB HIER DIE WICHTIGE ÄNDERUNG:
    %
    % Der bisher ermittelte schärfste Frame wird NICHT gespeichert.
    %
    % Stattdessen wird der 8. folgende Frame gespeichert.
    %
    % Beispiel:
    % bestIdx = 125
    % savedFrameIdx = 125 + 8 = 133
    % =========================================================================

    savedFrameIdx = bestIdx + framesAfterSharpest;

    if ~isempty(logID)
        fprintf(logID, ...
            '  -> Schärfster Frame: #%d (Score = %.4f)\n', ...
            bestIdx, bestScore);

        fprintf(logID, ...
            '  -> Gespeichert wird Frame #%d (%d Frames danach)\n', ...
            savedFrameIdx, framesAfterSharpest);
    end

    % --------- Video erneut öffnen ----------
    try

        vR = VideoReader(videoPath);

    catch ME

        warning('Video konnte zum zweiten Lesen nicht geöffnet werden: %s', ...
                ME.message);

        if ~isempty(logID)
            fprintf(logID, ...
                '  >> FEHLER BEIM ERNEUTEN ÖFFNEN: %s\n', ...
                ME.message);
        end

        result = struct( ...
            'VideoName', videoName, ...
            'BestFrameIdx', bestIdx, ...
            'SavedFrameIdx', NaN, ...
            'BestScore', bestScore, ...
            'BestFrameFile', '');

        return;
    end

    % --------- Bis zum gewünschten Frame lesen ----------
    savedFrameRGB = [];
    currentFrame = 0;

    while hasFrame(vR)

        try

            frameRGB = readFrame(vR);
            currentFrame = currentFrame + 1;

            % Gewünschten Frame erreicht?
            if currentFrame == savedFrameIdx

                savedFrameRGB = frameRGB;
                break;

            end

        catch ME

            warning('Fehler beim Lesen von Frame %d in %s – %s', ...
                    currentFrame + 1, videoPath, ME.message);

            if ~isempty(logID)
                fprintf(logID, ...
                    '  >> Fehler beim Lesen von Frame %d: %s\n', ...
                    currentFrame + 1, ME.message);
            end

        end
    end

    % --------- Gewünschter Frame existiert nicht ----------
    if isempty(savedFrameRGB)

        warning(['Der 8. folgende Frame (#%d) konnte in %s ' ...
                 'nicht gefunden werden.'], ...
                 savedFrameIdx, videoPath);

        if ~isempty(logID)
            fprintf(logID, ...
                ['  >> FRAME NICHT VORHANDEN: Frame #%d existiert nicht.\n'], ...
                savedFrameIdx);
        end

        result = struct( ...
            'VideoName', videoName, ...
            'BestFrameIdx', bestIdx, ...
            'SavedFrameIdx', NaN, ...
            'BestScore', bestScore, ...
            'BestFrameFile', '');

        return;
    end

    % --------- Bild speichern ----------
    outFile = fullfile( ...
        outFolder, ...
        sprintf('%s_schaerfsterFrame_plus8.png', name));

    try

        imwrite(savedFrameRGB, outFile, 'png');

    catch ME

        warning('Fehler beim Schreiben von %s – %s', ...
                outFile, ME.message);

        if ~isempty(logID)
            fprintf(logID, ...
                '  >> SCHREIBFEHLER: %s\n', ...
                ME.message);
        end

        outFile = '';

    end

    % --------- Log-Eintrag (Ergebnis) ----------
    if ~isempty(logID)

        fprintf(logID, ...
            '  -> Bester Frame #: %d (Score = %.4f)\n', ...
            bestIdx, bestScore);

        fprintf(logID, ...
            '  -> Tatsächlich gespeicherter Frame #: %d\n', ...
            savedFrameIdx);

        fprintf(logID, ...
            '  -> Gespeichert unter: %s\n', ...
            outFile);

    end

    % --------- Ergebnis-Struktur zurückgeben ----------
    result = struct( ...
        'VideoName', videoName, ...
        'BestFrameIdx', bestIdx, ...
        'SavedFrameIdx', savedFrameIdx, ...
        'BestScore', bestScore, ...
        'BestFrameFile', outFile);

end
